{
  "name": "zhixiaoli-campus-companion",
  "version": "1.0.3",
  "description": "智小理·校园伴行：校园业务与通用学习桌面助手",
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 && node start.js",
    "start:mac": "node start.js",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac dmg",
    "build:mac-arm": "electron-builder --mac dmg --arm64",
    "make-icons": "node scripts/make-icons.js"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "cn.zhixiaoli.campuscompanion",
    "productName": "智小理·校园伴行",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "start.js",
      "LICENSE",
      "NOTICE",
      "README.md",
      "config.example.json",
      "renderer/**/*",
      "services/**/*",
      "libs/marked.umd.js",
      "libs/purify.min.js",
      "libs/licenses/**/*",
      "assets/brand/**/*",
      "assets/zhixiaoli/**/*",
      "node_modules/pdfjs-dist/legacy/build/*.mjs",
      "node_modules/pdfjs-dist/cmaps/**/*",
      "node_modules/pdfjs-dist/standard_fonts/**/*",
      "node_modules/pdfjs-dist/wasm/**/*",
      ".runtime/python/**/*",
      "requirements-tts.txt"
    ],
    "asarUnpack": [
      ".runtime/python/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/brand/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/brand/icon.png",
      "category": "public.app-category.entertainment",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "artifactName": "Zhixiaoli-Campus-${version}-${arch}.dmg",
      "title": "智小理·校园伴行 ${version}"
    },
    "portable": {
      "artifactName": "Zhixiaoli-Campus-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智小理·校园伴行",
      "installerLanguages": [
        "en_US"
      ],
      "language": "1033",
      "installerHeaderIcon": "assets/brand/icon.ico",
      "artifactName": "Zhixiaoli-Campus-Setup-${version}.exe"
    },
    "executableName": "ZhixiaoliCampus"
  }
}
